rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "fusionsvault@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // CMS Content collection (Pages, Blogs, SEO configurations)
    // Public read for live website visitors; Admin & CMS write access
    match /cms/{cmsId} {
      allow get: if isValidId(cmsId);
      allow list: if true;
      allow create, update: if isValidId(cmsId);
      allow delete: if isValidId(cmsId) && isAdmin();
    }

    // Inbound Leads and Consultation Requests
    match /leads/{leadId} {
      allow get: if isValidId(leadId);
      allow list: if true;
      allow create: if isValidId(leadId) &&
        incoming().fullName is string && incoming().fullName.size() <= 120 &&
        incoming().email is string && incoming().email.size() <= 120;
      allow update, delete: if isValidId(leadId);
    }

    // Live Visitor Tracking & Chat Sessions
    match /visitor_sessions/{sessionId} {
      allow get, list: if isValidId(sessionId);
      allow create, update: if isValidId(sessionId) &&
        incoming().sessionId is string && incoming().sessionId.size() <= 128;
      allow delete: if isValidId(sessionId);
    }

    // Admin role lookup collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
